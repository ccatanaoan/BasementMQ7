Build1=Default,B4RDev
Group=Default Group
Library1=rcore
Library2=resp8266wifi
Library3=rmqtt
Library4=resp8266
Library5=resp8266timetools
NumberOfFiles=0
NumberOfLibraries=5
NumberOfModules=0
Version=4
@EndOfDesignText@
#Region Project Attributes
	#AutoFlushLogs: True
	#CheckArrayBounds: True
	#StackBufferSize: 3000
#End Region

Sub Process_Globals
	Public Serial1 As Serial

	' MQ-7
	Private MQ7Pin As Pin
	Private MQ7PinNumber As Byte = 0x00
	Private readVoltage As UInt

	' Wi-Fi
	Private WiFi As ESP8266WiFi
	Private WiFiStr As WiFiSocket

	Private WiFiSSID As String = "RiseAboveThisHome"
	Private WiFiPassword As String = "<WIFI_PASSWORD>"

	' MQTT - private Mosquitto broker on GEEKOM
	Private MQTT As MqttClient
	Private MQTTPort As Int = 1883
	Private MQTTClientId As String = "BasementMQ7"

	Private WiFiRetryScheduled As Boolean = False
	Private MQTTRetryScheduled As Boolean = False
	Private MQTTInitialized As Boolean = False
	Private MQTTConnected As Boolean = False

	' Prevent MQTT reconnects from starting duplicate MQ-7 cycles.
	Private SensorLoopStarted As Boolean = False

	Private ESP As ESP8266

	Public timelib As ESPTimetools

	Private TimeClientInitialized As Boolean = False
	Private ClockValid As Boolean = False

	Private ClockBaseTimestamp As ULong
	Private ClockBaseMillis As ULong

	Private NTPAttempted As Boolean = False
	Private LastNTPAttemptMillis As ULong
	Private LastNTPSuccessMillis As ULong

	Private pin16 As Pin
End Sub


Private Sub AppStart
	Serial1.Initialize(115200)

	Delay(3000)

	Log("AppStart")

	Dim bb() As Byte = "BasementMQ7"

	RunNative("SetHostName", bb)
	RunNative("stopAP", Null)

	pin16.Initialize(16, pin16.MODE_OUTPUT)

	pin16.DigitalWrite(True)

	' Initialize the MQ-7 pin exactly as the original project.
	MQ7Pin.Initialize(MQ7PinNumber, MQ7Pin.MODE_INPUT)

	' Prevent the ESP8266 from remaining connected to
	' its previously remembered guest Wi-Fi.
	RunNative("PrepareConfiguredWiFi", Null)

	Delay(500)

	ConnectToWifi
End Sub


' ============================================================
' WIFI
' ============================================================

Sub ConnectToWifi

	If WiFi.IsConnected Then

		WiFiRetryScheduled = False

		RunNative("EnableWifiAutoReconnect", Null)

		Log("Connected to ", WiFiSSID, _
			" network, Local IP ", WiFi.LocalIp)

		InitializeMQTT

		MQTT_Connect(0)

		Return
	End If


	pin16.DigitalWrite(True)

	Log("Connecting to ", WiFiSSID)


	If WiFi.Connect2(WiFiSSID, WiFiPassword) Then

		WiFiRetryScheduled = False

		RunNative("EnableWifiAutoReconnect", Null)

		Log("Connected to ", WiFiSSID, _
			" network, Local IP ", WiFi.LocalIp)

		InitializeMQTT

		MQTT_Connect(0)

	Else

		Log("WiFi connection failed")

		If WiFiRetryScheduled = False Then

			WiFiRetryScheduled = True

			CallSubPlus("WiFi_Retry", 5000, 0)

		End If

	End If
End Sub


Sub WiFi_Retry(Unused As Byte)

	WiFiRetryScheduled = False

	ConnectToWifi
End Sub


' ============================================================
' MQTT
' ============================================================

Private Sub InitializeMQTT

	If MQTTInitialized Then Return

	MQTT.Initialize( _
		WiFiStr.stream, _
		Array As Byte(192, 168, 1, 125), _
		MQTTPort, _
		MQTTClientId, _
		"MQTT_MessageArrived", _
		"MQTT_Disconnected")

	MQTTInitialized = True
End Sub


Sub MQTT_Connect(Unused As Byte)

	MQTTRetryScheduled = False


	If WiFi.IsConnected = False Then

		MQTTConnected = False

		ConnectToWifi

		Return
	End If


	If MQTTInitialized = False Then

		InitializeMQTT

	End If


	If MQTT.Connect = False Then

		MQTTConnected = False

		pin16.DigitalWrite(True)

		Log("Not connected to broker")

		If MQTTRetryScheduled = False Then

			MQTTRetryScheduled = True

			CallSubPlus("MQTT_Connect", 5000, 0)

		End If

	Else

		MQTTConnected = True

		pin16.DigitalWrite(False)

		Log("Connected to broker")

		MQTT.Subscribe("MQ7Basement", 0)

		' Start the MQ-7 heater/read cycle only once.
		If SensorLoopStarted = False Then

			ReadSensor

		Else

			Log("MQ-7 sensor loop already running")

		End If

	End If
End Sub


Sub MQTT_MessageArrived (Topic As String, Payload() As Byte)

	Log("Message arrived. Topic=", Topic, _
		" Payload=", Payload)


	If Topic = "MQ7Basement" Then

		If Payload = "Read voltage" Then

			' Return the last completed MQ-7 reading.
			' MQTT publishing never waits for NTP.

			Dim s As String

			s = BuildMQ7Payload(readVoltage)

			Log("Sending current MQ-7 value via MQTT: ", s)

			MQTT.Publish("MQ7Basement", s)

			' NTP happens only AFTER the MQTT response
			' has already been published.
			NTPRefreshIfNeeded


		Else If Payload = "Restart controller" Then

			MQTT.Publish( _
				"MQ7Basement", _
				"Restarting controller by remote")

			Delay(250)

			ESP.Restart

		End If

	End If
End Sub


Sub MQTT_Disconnected

	MQTTConnected = False

	pin16.DigitalWrite(True)

	Log("Disconnected from broker")

	MQTT.Close

	If MQTTRetryScheduled = False Then

		MQTTRetryScheduled = True

		CallSubPlus("MQTT_Connect", 5000, 0)

	End If
End Sub


' ============================================================
' TIME
'
' MQTT publishing never depends on NTP.
'
' If no synchronized clock exists:
'   Publish using:
'      1970-01-01 | 00:00:00
'
' AFTER the MQTT publish:
'   Attempt NTP synchronization.
'
' Once synchronized:
'   Maintain the clock from the saved NTP timestamp + Millis.
'
' Resync:
'   Every 6 hours.
'
' Failed NTP:
'   Keep the existing clock if one exists.
'   Continue MQ-7 operation normally.
'   Retry no more often than every 5 minutes.
' ============================================================

Private Sub StartTimeSystem

	If TimeClientInitialized = False Then

		timelib.initialize("pool.ntp.org", 0)

		TimeClientInitialized = True

		Log("NTP client initialized")

	End If

End Sub


Private Sub TimeSync

	If WiFi.IsConnected = False Then

		Return

	End If


	NTPAttempted = True

	LastNTPAttemptMillis = Millis


	If TimeClientInitialized = False Then

		StartTimeSystem

	End If


	Dim NewTimestamp As ULong

	NewTimestamp = timelib.timestamp


	If NewTimestamp <> 0 Then

		ClockBaseTimestamp = NewTimestamp

		ClockBaseMillis = Millis

		LastNTPSuccessMillis = ClockBaseMillis

		ClockValid = True

		Log("NTP sync OK. Timestamp=", NewTimestamp)

	Else

		If ClockValid Then

			Log("NTP sync failed - keeping synchronized local clock")

		Else

			Log("NTP sync failed - MQ-7 publishing remains active")

		End If

	End If

End Sub


Private Sub GetCurrentTimestamp As ULong

	If ClockValid = False Then

		Return 0

	End If


	Dim ElapsedMs As ULong

	ElapsedMs = Millis - ClockBaseMillis


	Dim ElapsedSeconds As ULong

	ElapsedSeconds = ElapsedMs / 1000


	Return ClockBaseTimestamp + ElapsedSeconds

End Sub


Private Sub NTPRefreshIfNeeded

	Dim CurrentMillis As ULong

	CurrentMillis = Millis


	If ClockValid = False Then

		If NTPAttempted = False Then

			TimeSync

			Return

		End If


		Dim SinceAttempt As ULong

		SinceAttempt = CurrentMillis - LastNTPAttemptMillis


		If SinceAttempt >= 300000 Then

			TimeSync

		End If


	Else

		Dim SinceSuccess As ULong

		SinceSuccess = CurrentMillis - LastNTPSuccessMillis


		If SinceSuccess >= 21600000 Then

			Dim SinceAttempt As ULong

			SinceAttempt = CurrentMillis - LastNTPAttemptMillis


			If SinceAttempt >= 300000 Then

				TimeSync

			End If

		End If

	End If

End Sub


Private Sub BuildMQ7Payload(VoltageValue As UInt) As String

	Dim CurrentTimestamp As ULong

	CurrentTimestamp = GetCurrentTimestamp


	Dim DatePart As String
	Dim TimePart As String


	If CurrentTimestamp <> 0 Then

		DatePart = JoinStrings(Array As String( _
			NumberFormat(timelib.getyear(CurrentTimestamp),2,0), "-", _
			NumberFormat(timelib.getmonth(CurrentTimestamp),2,0), "-", _
			NumberFormat(timelib.getday(CurrentTimestamp),2,0)))


		TimePart = JoinStrings(Array As String( _
			NumberFormat(timelib.gethour(CurrentTimestamp),2,0), ":", _
			NumberFormat(timelib.getminute(CurrentTimestamp),2,0), ":", _
			NumberFormat(timelib.getseconds(CurrentTimestamp),2,0)))

	Else

		DatePart = "1970-01-01"

		TimePart = "00:00:00"

		Log("Clock not synchronized - publishing MQ-7 data anyway")

	End If


	Return JoinStrings(Array As String( _
		VoltageValue, "|", _
		DatePart, "|", _
		TimePart))

End Sub


' ============================================================
' MQ-7 SENSOR CYCLE
' ============================================================

Public Sub ReadSensor

	If SensorLoopStarted Then Return

	SensorLoopStarted = True

	Log("Starting MQ-7 sensor cycle")

	Preparation1(0)
End Sub


Sub Preparation1(tag As Byte)

	Log("Turn the heater fully on")

	MQ7Pin.AnalogWrite(1024)

	Log("Heat for 1 min")

	CallSubPlus("Preparation2", 60000, 0)
End Sub


Sub Preparation2(tag As Byte)

	Log("Now reducing the heating power: turn the heater to approx 1.5V")

	MQ7Pin.AnalogWrite(307.2)

	Log("Heat for 90 sec")

	CallSubPlus("ReadSensor1", 90000, 0)
End Sub


Sub ReadSensor1(tag As Byte)

	Log("We need to read the sensor at 5V, but must not let it heat up. So hurry!")

	MQ7Pin.AnalogWrite(1024)

	Log("Delay for 50 milli")

	CallSubPlus("ReadSensor2", 50, 0)
End Sub


Sub ReadSensor2(tag As Byte)

	' Preserve the original MQ-7 calculation exactly.
	Dim rawvoltage As UInt = MQ7Pin.AnalogRead / 2

	Log("*************************")

	Log("MQ-7 PPM: ", rawvoltage)

	readVoltage = rawvoltage


	' Build the MQTT payload without requiring NTP.
	Dim s As String

	s = BuildMQ7Payload(rawvoltage)


	If WiFi.IsConnected And MQTTConnected Then

		Log("Sending ppm via MQTT: ", s)

		MQTT.Publish("MQ7Basement", s)

	Else

		Log("MQTT unavailable - MQ-7 reading saved locally but publish skipped")

	End If


	' NTP happens only AFTER the MQ-7 reading has been
	' processed and any possible MQTT publish is finished.
	NTPRefreshIfNeeded


	' Preserve the original air-quality thresholds exactly.
	If rawvoltage <= 100 Then

		Log("Air-Quality: CO perfect")

	Else If ((rawvoltage > 100) And (rawvoltage < 400)) Or rawvoltage = 400 Then

		Log("Air-Quality: CO normal")

	Else If ((rawvoltage > 400) And (rawvoltage < 900)) Or rawvoltage = 900 Then

		Log("Air-Quality: CO high")

	Else If rawvoltage > 900 Then

		Log("Air-Quality: ALARM CO very high")

	Else

		Log("MQ-7 - cant read any value - check the sensor!")

	End If


	Log("*************************")


	' Start the next existing MQ-7 cycle after 1 second.
	CallSubPlus("Preparation1", 1000, 0)
End Sub


' ============================================================
' NATIVE C
' ============================================================

#If C

void SetHostName(B4R::Object* o) {

	B4R::Array* b =
		(B4R::Array*)B4R::Object::toPointer(o);

	char* c = (char*)b->data;

	WiFi.hostname(c);

}


void stopAP(B4R::Object* u) {

	WiFi.softAPdisconnect(true);

}


void PrepareConfiguredWiFi(B4R::Object* u) {

	WiFi.persistent(false);

	WiFi.setAutoReconnect(false);

	WiFi.disconnect();

	delay(250);

	WiFi.mode(WIFI_STA);

}


void EnableWifiAutoReconnect(B4R::Object* u) {

	WiFi.setAutoReconnect(true);

}

#End If